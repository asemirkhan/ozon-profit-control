PGHOST=localhost
PGPORT=5432
PGDATABASE=ozon_db
PGUSER=ozon
PGPASSWORD=replace_with_a_random_local_password

# Optional fallback for CLI --schema
OZON_SCHEMA=client_demo

# Ozon Seller API credentials
OZON_CLIENT_ID=your_client_id
OZON_API_KEY=your_api_key

# Optional Ozon Ads API credentials / routing:
# - If OZON_ADS_TOKEN is set, connector prefers Performance API endpoint.
# - If only seller creds are available, connector tries legacy seller endpoint first.
# OZON_ADS_TOKEN=your_ozon_ads_bearer_token
# OZON_ADS_CLIENT_ID=your_ozon_ads_client_id
# OZON_ADS_API_KEY=your_ozon_ads_api_key
# OZON_ADS_STATS_URL=https://api-performance.ozon.ru/api/client/statistics/json
# OZON_ADS_GROUP_BY=SKU
# OZON_ADS_CAMPAIGN_IDS=12345,67890

# Optional Ozon TLS/SSL config for local diagnostics:
# 1) Custom CA bundle priority:
#    - OZON_CA_BUNDLE
#    - SSL_CERT_FILE
#    - REQUESTS_CA_BUNDLE
# OZON_CA_BUNDLE=/absolute/path/to/ca-bundle.pem
#
# 2) Dev-only mode to disable TLS verification (default: disabled)
# OZON_SSL_NO_VERIFY=1

# Wildberries API credentials
# WB auth priority in code:
# 1) WB_API_TOKEN
# 2) WB_API_KEY
WB_API_TOKEN=your_wb_api_token
# WB_API_KEY=your_wb_api_key
# Required when a base/service token is used for protected WB API sections.
# For a local seller integration, prefer a personal token with Analytics access.
# WB_CLIENT_SECRET=your_wb_service_secret
# WB_CLIENT_ID is optional and currently not used by connector auth:
# WB_CLIENT_ID=your_wb_client_id

# Optional WB endpoint URL overrides:
# WB_PRODUCTS_URL=https://content-api.wildberries.ru/content/v2/get/cards/list
# WB_ORDERS_URL=https://statistics-api.wildberries.ru/api/v1/supplier/orders
# WB_SALES_URL=https://statistics-api.wildberries.ru/api/v1/supplier/sales
# WB_FINANCE_URL=https://statistics-api.wildberries.ru/api/v5/supplier/reportDetailByPeriod
# WB_ADS_CAMPAIGNS_URL=https://advert-api.wildberries.ru/adv/v1/promotion/count
# WB_ADS_STATS_URL=https://advert-api.wildberries.ru/adv/v3/fullstats
# WB_ADS_STATS_MAX_IDS=50
# WB_ADS_MAX_CAMPAIGNS=20
# WB_ADS_ACTIVE_STATUSES=9,11
# WB_STOCK_URL=https://statistics-api.wildberries.ru/api/v1/supplier/stocks

# Optional WB TLS/SSL config for local diagnostics:
# WB_CA_BUNDLE=/absolute/path/to/ca-bundle.pem
# WB_SSL_NO_VERIFY=1

# Optional ingestion stability controls:
# chunk retry at unified runner level
# INGEST_CHUNK_MAX_RETRIES=4
# INGEST_CHUNK_RETRY_DELAYS_SEC=5,10,20,40
#
# WB connector request-level retry/backoff + throttling
# WB_HTTP_MAX_ATTEMPTS=5
# WB_HTTP_RETRY_DELAYS_SEC=5,10,20,40
# WB_HTTP_GLOBAL_RPS=2.5
# WB_MAX_REQUESTS_PER_SECOND=2.5
# WB_MAX_PARALLEL_REQUESTS_PER_SOURCE=1
